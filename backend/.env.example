# Copie para .env e preencha. Nunca commite o .env.
NODE_ENV=development
PORT=8000

# Único site aceito pelo CORS
FRONTEND_URL=http://localhost:5173

# Usuário da aplicação, nunca o postgres. Codifique símbolos da senha (@ = %40).
DATABASE_URL=postgresql://app_kabana_kids:SENHA@127.0.0.1:5432/kabana_kids

# Banco dos testes: precisa terminar em _test (os testes apagam dados)
TEST_DATABASE_URL=postgresql://app_kabana_kids:SENHA@127.0.0.1:5432/kabana_kids_test

# Banco temporário que o Prisma usa para criar migrations
SHADOW_DATABASE_URL=postgresql://app_kabana_kids:SENHA@127.0.0.1:5432/kabana_kids_shadow

# Quantos proxies da hospedagem ficam antes da API (0 = nenhum).
# Em produção, use o número indicado pela hospedagem.
TRUST_PROXY=0
