# Copie para .env e preencha. Nunca commite o .env.
NODE_ENV=development
PORT=8000

# Único site aceito pelo CORS
FRONTEND_URL=http://localhost:5173

# Usuário da aplicação, nunca o postgres. Codifique símbolos da senha (@ = %40).
DATABASE_URL=postgresql://app_kabana_kids:SENHA@127.0.0.1:5432/kabana_kids

# Banco dos testes: precisa terminar em _test (os testes apagam dados)
TEST_DATABASE_URL=postgresql://app_kabana_kids:SENHA@127.0.0.1:5432/kabana_kids_test

# Banco temporário que o Prisma usa para criar migrations
SHADOW_DATABASE_URL=postgresql://app_kabana_kids:SENHA@127.0.0.1:5432/kabana_kids_shadow

# Quantos proxies da hospedagem ficam antes da API (0 = nenhum).
# Em produção, use o número indicado pela hospedagem.
TRUST_PROXY=0

# Chave que criptografa o segredo do 2FA no banco (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca reaproveite a chave de outro ambiente.
TWO_FACTOR_ENCRYPTION_KEY=GERE-UMA-CHAVE-NOVA

# E-mail (links de senha). Em desenvolvimento, "outbox" grava os
# e-mails em storage/mail-outbox (fora do Git). Em produção: smtp.
MAIL_TRANSPORT=outbox
MAIL_FROM=Kabana Kids <nao-responda@kabanakids.com.br>
# Só para MAIL_TRANSPORT=smtp (porta 587 com STARTTLS ou 465 com TLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
